{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    {
      "name": "Gremstudio"
    }
  ],
  "contributors": [
    {
      "name": "Siuolplex - Studio Lead",
      "contact": {
        "bluesky": "https://bsky.app/profile/siuol.bsky.social"
      }
    }
  ],
  "contact": {},
  "license": "${license}",
  "icon": "${icon}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.gremstudio.gremlib.fabric.GremlibFabric"
